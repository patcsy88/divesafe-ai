# Copy to .env (never commit .env). All values are placeholders.
# Variables are read by divesafe.config.settings.Settings (prefix DIVESAFE_).

DIVESAFE_ENVIRONMENT=development
DIVESAFE_LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector). Use the same password as POSTGRES_PASSWORD below.
POSTGRES_PASSWORD=change-me
# Production: the app DSN needs ?sslmode=require (or verify-full) and a least-privilege role.
# URL-encode special characters in the password.
DIVESAFE_DATABASE_URL=postgresql://divesafe:change-me@localhost:5432/divesafe
# Owner-role DSN, used only by `python -m divesafe.services.db_init`; never given to the app.
DIVESAFE_ADMIN_DATABASE_URL=
DIVESAFE_APP_DB_ROLE=

# LLM provider selection: openai | anthropic | ollama | fake
DIVESAFE_LLM_PROVIDER=fake
DIVESAFE_LLM_MODEL=
# Only the key for the selected provider is needed. Leave empty otherwise.
DIVESAFE_LLM_API_KEY=
# Ollama / OpenAI-compatible servers
DIVESAFE_LLM_BASE_URL=
# Hosted providers (OpenAI, Anthropic, ...) receive evidence and dive-plan data. Opt in explicitly.
DIVESAFE_ALLOW_EXTERNAL_LLM=false
# Any non-loopback LLM server, including a LAN Ollama, is external and needs the opt-in above.
# Exact hostnames (comma-separated) allowed to use plain http. Dev/test only: the prompt (plan and
# evidence) is unencrypted and the server can be impersonated. Refused in production.
DIVESAFE_OLLAMA_PLAIN_HTTP_HOSTS=
# Time budgets for a slow self-hosted model (defaults shown). A longer stage delays the assessment.
# DIVESAFE_LLM_CALL_TIMEOUT_SECONDS=60
# DIVESAFE_LLM_STAGE_TIMEOUT_SECONDS=150
# DIVESAFE_LLM_FIRST_BYTE_TIMEOUT_SECONDS=15
# DIVESAFE_LLM_MAX_CONCURRENT_CALLS=4

# Evidence policy (set explicitly; there are intentionally no built-in safety thresholds)
DIVESAFE_EVIDENCE_MAX_AGE_MINUTES=
# Reviewed ruleset of signed-off limits (JSON). Unset = no limits (every assessment stays
# INSUFFICIENT EVIDENCE). The app refuses to start if any definition is invalid or expired.
DIVESAFE_RULESET_PATH=
# Pin the reviewed file: startup fails if its SHA-256 differs (lowercase hex). Recommended.
DIVESAFE_RULESET_SHA256=
# Reject human decisions on assessments older than this (unset = no limit; set it)
DIVESAFE_DECISION_MAX_AGE_MINUTES=

# Authentication: api_key (default) or dev (development/test only; actor taken from X-Dev-Actor)
DIVESAFE_AUTH_MODE=api_key
# JSON {"<sha256 hex of key>": {"actor": "name", "roles": ["viewer","assessor","decider"]}}.
# Roles are separate: viewer reads, assessor creates assessments, decider records the human
# decision and actual conditions. A key with no roles is refused at startup. Create a hash with:
#   python3 -c "import hashlib,secrets;k=secrets.token_urlsafe(32);print(k);print(hashlib.sha256(k.encode()).hexdigest())"
# Keep the key itself private; only the hash goes here. Requests send 'Authorization: Bearer <key>'.
DIVESAFE_API_KEY_HASHES=
# Failed authentications allowed per source per minute before it is refused with 429.
DIVESAFE_RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=10
# Comma-separated IPs of reverse proxies you control (for example the web server), whose last
# X-Forwarded-For entry is believed. Empty: the TCP peer is the source, so everyone behind a proxy
# shares one limit. Never list a shared gateway. Pair with DIVESAFE_WEB_TRUST_PROXY=1 in web/.env.
DIVESAFE_TRUSTED_PROXIES=
