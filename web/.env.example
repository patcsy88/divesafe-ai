# Server-side only. Neither value is ever sent to the browser.
DIVESAFE_API_URL=http://127.0.0.1:8000
# At least 32 random characters, for example: openssl rand -base64 48
DIVESAFE_WEB_SESSION_SECRET=
# Set to 1 only if a reverse proxy you control sets X-Forwarded-For. Otherwise leave unset: the
# header is ignored and all sign-ins share one failure limit. For the API to count per person, also
# set DIVESAFE_TRUSTED_PROXIES on the API to this web server's IP.
DIVESAFE_WEB_TRUST_PROXY=
