# Non-secret settings for docker-compose.production.yml (ADR 0024, proposed; one assessment went through on the owner's host, not a tested deployment).
# Copy to docker/production.env
# (git ignores it). Secrets do NOT go here: they are files in docker/secrets.
DIVESAFE_LLM_BASE_URL=https://wall-e.ch30ng.org/v1
DIVESAFE_LLM_ALLOWED_HOSTS=wall-e.ch30ng.org
# ADR 0028: the one model host that APPROVED site documents may be sent to (and the vendor behind
# it). Empty: every site document stays withheld. If set, it must equal the base URL's host, be in
# DIVESAFE_LLM_ALLOWED_HOSTS, and every APPROVED version must attest model-host egress, or the API
# refuses to start. Deploy in the ADR's three steps.
DIVESAFE_LLM_KNOWLEDGE_HOST=
# The model name the host serves.
DIVESAFE_LLM_MODEL=
# Output tokens per model call. 3000 is the value evaluation runs 2 and 3 used; the 1500 default lost
# four agent calls to the token limit in the first real run. A reply over the limit is refused, not trimmed.
DIVESAFE_LLM_MAX_OUTPUT_TOKENS=3000
# Seconds for one model call and for the whole agent stage. Evaluation runs 2 and 3 used 3000 tokens
# with 120 and 300 together; at the code defaults (60 and 150) a longer reply may time out instead.
DIVESAFE_LLM_CALL_TIMEOUT_SECONDS=120
DIVESAFE_LLM_STAGE_TIMEOUT_SECONDS=300
# Required: there is no built-in default (docs/risk-model.md). Without it no assessment can be created.
# Once a signed ruleset exists this is a safety limit: record the value and its reason first (ADR 0024).
DIVESAFE_EVIDENCE_MAX_AGE_MINUTES=
# Owner decision (2026-10-18): decisions on an assessment older than this are refused.
DIVESAFE_DECISION_MAX_AGE_MINUTES=180
# Addresses the API sees the reverse proxy connecting from (see .env.example). Behind Docker's port
# publishing that may be the network gateway rather than the proxy's own address: check it. Empty:
# everyone behind it shares one failed-login limit. Never an address in 10.231.77.0/24 (the
# divesafe-trace network, ADR 0027): Langfuse could then choose its own failed-login bucket.
# A listed proxy is also trusted to set X-Request-ID (ADR 0027 item 1): it must replace or strip
# any X-Request-ID the client sent, never pass it through.
DIVESAFE_TRUSTED_PROXIES=
# Required by every compose command on the production file, even when the loader is not run.
# The host directory holding the knowledge corpus (manifest.json at its root), mounted read-only
# into kb_load only. It must be OUTSIDE this repository (licensed text; docs/knowledge-loader.md).
# This placeholder is fake on purpose: the loader refuses when no manifest is at the mount.
DIVESAFE_CORPUS_DIR=/set/me/outside/the/repository
# ADR 0027 amendment: metadata-only spans to the local Langfuse. Off: false and empty. On (owner):
# DIVESAFE_TRACING_ENABLED=true and
# DIVESAFE_TRACE_ENDPOINT=http://10.231.77.10:3000/api/public/otel/v1/traces, only once the
# divesafe-trace network and Langfuse run and both key files in docker/secrets are filled in.
DIVESAFE_TRACING_ENABLED=false
DIVESAFE_TRACE_ENDPOINT=
# ADR 0027 item 2: scrapes of /metrics per key per minute (default 30). The scraper's key holds
# only {"actor": "scraper", "roles": ["metrics"]}: no other role, no groups (start-up refuses).
# No PROMETHEUS_* variable may be set: start-up refuses.
DIVESAFE_RATE_LIMIT_METRICS_PER_MINUTE=30
