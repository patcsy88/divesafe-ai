# Non-secret settings for docker-compose.production.yml (ADR 0024, proposed; started on a developer machine, not exercised).
# Copy to docker/production.env
# (git ignores it). Secrets do NOT go here: they are files in docker/secrets.
DIVESAFE_LLM_BASE_URL=https://wall-e.ch30ng.org/v1
DIVESAFE_LLM_ALLOWED_HOSTS=wall-e.ch30ng.org
# The model name the host serves.
DIVESAFE_LLM_MODEL=
# Required: there is no built-in default (docs/risk-model.md). Without it no assessment can be created.
# Once a signed ruleset exists this is a safety limit: record the value and its reason first (ADR 0024).
DIVESAFE_EVIDENCE_MAX_AGE_MINUTES=
# Owner decision (2026-10-18): decisions on an assessment older than this are refused.
DIVESAFE_DECISION_MAX_AGE_MINUTES=180
# Addresses the API sees the reverse proxy connecting from (see .env.example). Behind Docker's port
# publishing that may be the network gateway rather than the proxy's own address: check it. Empty:
# everyone behind it shares one failed-login limit.
DIVESAFE_TRUSTED_PROXIES=
